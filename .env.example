# .env.example
# Telegram Bot Token (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database (for docker-compose)
DB_HOST=postgres
DB_PORT=5432
DB_USER=bot
DB_PASSWORD=your_password_here
DB_NAME=tracker_bot
DB_SSLMODE=disable

# Logging
LOG_LEVEL=info  # debug, info, warn, error

# HTTP server for health checks
HTTP_PORT=8080